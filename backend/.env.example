# Copy to .env and fill in. Never commit the real .env.
# This .example file must contain placeholders ONLY — no real secrets.

# ==============================================================================
# 1. Trading Mode & Working Capital
# ==============================================================================
# Mode: sandbox | live_approval | live_auto | backtest
#   - sandbox       : Paper trading against tastytrade cert environment (auto-places)
#   - live_approval : Live account, orders queue on dashboard awaiting manual 1-click approval
#   - live_auto     : Live account, fully autonomous execution (opt-in)
#   - backtest      : Records planned trades without placing broker orders
TASTYAGENT_MODE=sandbox

# Working capital to size against in USD (default: 10000.0).
# The sandbox seeds ~$1M with no withdrawal endpoint; the agent simulates this
# working capital figure to size small defined-risk trades realistically.
TASTYAGENT_WORKING_CAPITAL=10000.0


# ==============================================================================
# 2. Tastytrade Sandbox (Cert) Credentials
# ==============================================================================
# Sandbox login credentials (used by scripts/provision_sandbox.py to create
# and fund the paper account up to $1M).
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ACCOUNT=                 # Sandbox account number (e.g. 5WX01234), filled after provisioning

# Sandbox OAuth application grant (scope: "read trade").
# Generated in the Tastytrade developer portal in the cert/sandbox environment.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_OAUTH_REFRESH_TOKEN=


# ==============================================================================
# 3. Tastytrade Production READ-ONLY Grant (for IV Rank)
# ==============================================================================
# The cert (sandbox) environment does NOT serve /market-metrics (returns 502).
# IV rank is a core entry guardrail input, so it must be fetched from production.
# Request scope: `read` ONLY (no `trade` scope) so this grant physically CANNOT
# place live orders.
TASTYTRADE_PROD_CLIENT_SECRET=
TASTYTRADE_PROD_OAUTH_REFRESH_TOKEN=


# ==============================================================================
# 4. Adaptive LLM Layer (OpenRouter)
# ==============================================================================
# OpenRouter API key and model selection.
# Default model: deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Optional OpenRouter overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://github.com/swechencheng/TastyAgent
# OPENROUTER_APP_NAME=TastyAgent


# ==============================================================================
# 5. Optional Strategy Parameter Overrides (defaults in config.py apply if unset)
# ==============================================================================
# TASTYAGENT_MIN_IV_RANK=0.30             # Minimum IV rank threshold (0..1 fraction, e.g. 0.30 = 30%)
# TASTYAGENT_MIN_DTE=30                   # Minimum expiration days
# TASTYAGENT_MAX_DTE=55                   # Maximum expiration days
# TASTYAGENT_TARGET_DTE=45                # Target expiration days
# TASTYAGENT_MAX_SHORT_LEG_DELTA=0.30     # Absolute delta cap on any short leg
# TASTYAGENT_MAX_BID_ASK_WIDTH_PCT=0.10   # Maximum (ask - bid) / mid ratio (relaxed to 0.50 in sandbox)
# TASTYAGENT_MIN_OPEN_INTEREST=500        # Minimum open interest
# TASTYAGENT_MIN_DAILY_VOLUME=100         # Minimum daily option volume
# TASTYAGENT_EARNINGS_BLACKOUT_DAYS=7     # Days before earnings to avoid opening new positions
# TASTYAGENT_TAKE_PROFIT_PCT=0.50         # Take profit at fraction of max profit (50%)
# TASTYAGENT_MANAGE_DTE=21                # Roll out to next cycle when remaining DTE reaches this
# TASTYAGENT_STOP_LOSS_MULTIPLE=2.0       # Stop loss multiple of credit (when use_hard_stop is true)


# ==============================================================================
# 6. Optional Risk Limit Overrides (defaults in config.py apply if unset)
# ==============================================================================
# TASTYAGENT_MAX_TRADE_BP_PCT=0.25        # Max buying-power reduction per trade vs net liq (25%)
# TASTYAGENT_MAX_TOTAL_BP_PCT=0.40        # Max aggregate buying-power usage vs net liq (40%)
# TASTYAGENT_MAX_POSITIONS=15             # Maximum concurrent open positions
# TASTYAGENT_MAX_POSITIONS_PER_SYMBOL=2   # Maximum concurrent positions per underlying
# TASTYAGENT_MAX_DAILY_LOSS_PCT=0.03      # Daily realized loss threshold to halt entries (3%)
# TASTYAGENT_CONSECUTIVE_LOSS_HALT=5      # Halt entries after N consecutive losing trades
# TASTYAGENT_KILL_SWITCH=false            # Hard stop on all new orders
