# Copy to .env and fill in. Never commit the real .env.
# This .example file must contain placeholders ONLY — no real secrets.

# Trading mode: backtest | sandbox | live_approval | live_auto
TASTYAGENT_MODE=sandbox

# TastyTrade credentials.
# Sandbox (cert) and production each require a SEPARATE set of credentials.
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ACCOUNT=            # e.g. 5WX01234

# OAuth (preferred). Generated in the TastyTrade developer portal.
# The refresh token mints short-lived access tokens.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_OAUTH_REFRESH_TOKEN=

# Production READ-ONLY OAuth grant, used ONLY to fetch /market-metrics (IV rank),
# which is not served in the sandbox. Request scope `read` ONLY (no `trade`) so
# this grant physically cannot place a live order. Orders still run on the
# sandbox grant above.
TASTYTRADE_PROD_CLIENT_SECRET=
TASTYTRADE_PROD_OAUTH_REFRESH_TOKEN=

# Anthropic API key for the adaptive LLM layer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Optional overrides (else defaults in config.py apply)
# TASTYAGENT_MIN_IV_RANK=30
# TASTYAGENT_MAX_TOTAL_BP_PCT=0.40
